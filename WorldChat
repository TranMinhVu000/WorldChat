-- 3. GỬI LÊN DISCORD
local function sendToDiscord(cName, flag, author, message)
    if message == "" then return end
    local url = "https://discord.com/api/v10/channels/" .. CHANNEL_ID .. "/messages"
    local headers = {
        ["Authorization"] = "Bot " .. BOT_TOKEN,
        ["Content-Type"] = "application/json"
    }
    local timeStr = os.date("%Hh %Mp %Ss")
    local data = {
        embeds = {{
            description = string.format("[%s]|[%s]|%s|%s|%s", timeStr, cName, flag, author, message)
        }}
    }
    local requestFunc = (syn and syn.request) or (http and http.request) or http_request or request
    if requestFunc then
        task.spawn(function()
            requestFunc({Url = url, Method = "POST", Headers = headers, Body = HttpService:JSONEncode(data)})
        end)
    end
end

-- 4. HÀM ĐỒNG BỘ TIN NHẮN TỪ DISCORD
local lastProcessedMsgId = nil
local isFirstLoad = true

local function syncFromDiscord()
    local url = "https://discord.com/api/v10/channels/" .. CHANNEL_ID .. "/messages?limit=15"
    local req = (syn and syn.request) or http_request or request
    if not req then return end

    local success, res = pcall(function() 
        return req({Url = url, Method = "GET", Headers = {["Authorization"] = "Bot " .. BOT_TOKEN}}) 
    end)
    
    if success and res and res.StatusCode == 200 then
        local messages = HttpService:JSONDecode(res.Body)
        if not messages or #messages == 0 then return end
        
        table.sort(messages, function(a, b)
            return a.id < b.id
        end)
        
        if isFirstLoad then
            isFirstLoad = false
            lastProcessedMsgId = messages[#messages].id
            for _, msg in ipairs(messages) do
                local content = msg.content or ""
                if msg.embeds and msg.embeds[1] and msg.embeds[1].description then
                    local rawText = msg.embeds[1].description
                    if string.find(rawText, "|") then
                        local parts = string.split(rawText, "|")
                        if #parts >= 5 then
                            addTerminalLog(parts[2]:gsub("[%[%]]", ""), parts[3], parts[4], parts[5], parts[1]:gsub("[%[%]]", ""), false)
                        end
                    end
                elseif content ~= "" and not (msg.author and msg.author.bot) then
                    addTerminalLog("ADMIN", "🔨", msg.author.username, content, nil, true)
                end
            end
            return
        end

        for _, msg in ipairs(messages) do
            if lastProcessedMsgId == nil or msg.id > lastProcessedMsgId then
                lastProcessedMsgId = msg.id
                local content = msg.content or ""
                
                if content:lower() == "/clear" then
                    clearChatUI()
                elseif msg.embeds and msg.embeds[1] and msg.embeds[1].description then
                    local rawText = msg.embeds[1].description
                    if string.find(rawText, "|") then
                        local parts = string.split(rawText, "|")
                        if #parts >= 5 then
                            addTerminalLog(parts[2]:gsub("[%[%]]", ""), parts[3], parts[4], parts[5], parts[1]:gsub("[%[%]]", ""), false)
                        end
                    end
                elseif content ~= "" and not (msg.author and msg.author.bot) then
                    addTerminalLog("ADMIN", "🔨", msg.author.username, content, nil, true)
                end
            end
        end
    end
end

-- Vòng lặp quét Discord mỗi 2 giây
task.spawn(function()
    while task.wait(2) do
        pcall(syncFromDiscord)
    end
end)

-- 5. BẮT CHAT REALTIME TỪ ROBLOX
local processMsgs = {}
if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
    TextChatService.MessageReceived:Connect(function(textChatMessage)
        if textChatMessage.TextSource and not processMsgs[textChatMessage.MessageId] then
            processMsgs[textChatMessage.MessageId] = true
            local sender = Players:GetPlayerByUserId(textChatMessage.TextSource.UserId)
            if sender and sender ~= LocalPlayer then
                local cName, flag = getPlayerCountryInfo(sender)
                addTerminalLog(cName, flag, sender.Name, textChatMessage.Text, nil, false)
                sendToDiscord(cName, flag, sender.Name, textChatMessage.Text)
            end
        end
    end)
end

-- 6. GỬI TIN NHẮN TỪ ROBLOX
local function sendMessage()
    local text = WorldChatInput.Text
    if text ~= "" then
        WorldChatInput.Text = ""
        local myName, myFlag = getPlayerCountryInfo(LocalPlayer)
        addTerminalLog(myName, myFlag, LocalPlayer.Name, text, nil, false)
        sendToDiscord(myName, myFlag, LocalPlayer.Name, text)
    end
end

