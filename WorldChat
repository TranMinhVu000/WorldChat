local function scrollToTop()
    task.wait(0.02)
    WorldChatLogContainer.CanvasPosition = Vector2.new(0, 0)
end

local function fastClearDiscord()
    local reqFunc = (syn and syn.request) or http_request or request
    if not reqFunc then return end

    task.spawn(function()
        local getUrl = "https://discord.com/api/v10/channels/" .. CHANNEL_ID .. "/messages?limit=100"
        local res = reqFunc({Url = getUrl, Method = "GET", Headers = {["Authorization"] = "Bot " .. BOT_TOKEN}})
        
        if res and res.StatusCode == 200 then
            local msgs = HttpService:JSONDecode(res.Body)
            local msgIds = {}
            for _, m in ipairs(msgs) do
                table.insert(msgIds, m.id)
            end
            
            if #msgIds > 0 then
                local deleteUrl = "https://discord.com/api/v10/channels/" .. CHANNEL_ID .. "/messages/bulk-delete"
                reqFunc({
                    Url = deleteUrl,
                    Method = "POST",
                    Headers = {
                        ["Authorization"] = "Bot " .. BOT_TOKEN,
                        ["Content-Type"] = "application/json"
                    },
                    Body = HttpService:JSONEncode({messages = msgIds})
                })
            end
        end
    end)
end

local function clearChatUI()
    for _, child in ipairs(WorldChatLogContainer:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    msgCounter = 0
    recentLogs = {}
    fastClearDiscord()
end

local function showMiniNotification(author, message, isDiscord)
    if WorldChatFrame.Visible then return end
    
    if isDiscord then
        WorldChatNotifyText.Text = string.format("<font color=\"rgb(0,255,150)\"><b>[ADMIN]</b></font> <font color=\"rgb(80,180,255)\"><b>%s</b>:</font> <b><font color=\"rgb(255,255,255)\">%s</font></b>", author, message)
    else
        WorldChatNotifyText.Text = string.format("<font color=\"rgb(80,180,255)\"><b>%s</b>:</font> <font color=\"rgb(240,240,240)\">%s</font>", author, message)
    end
    
    WorldChatNotifyFrame.Visible = true
    
    if notifyThread then task.cancel(notifyThread) end
    notifyThread = task.delay(4, function()
        WorldChatNotifyFrame.Visible = false
    end)
end

